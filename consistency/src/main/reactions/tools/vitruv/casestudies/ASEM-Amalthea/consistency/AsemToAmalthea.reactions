// E22 — InitTask/SoftwareTask/PeriodicTask/TimeTableTask created directly on the ASEM
// side -> create a plain AMALTHEA Task
reaction AsemInitTaskCreated {
    after element asem_c::InitTask created
    call createTaskForAsemTaskSubtype(affectedEObject)
}

reaction AsemSoftwareTaskCreated {
    after element asem_c::SoftwareTask created
    call createTaskForAsemTaskSubtype(affectedEObject)
}

reaction AsemPeriodicTaskCreated {
    after element asem_c::PeriodicTask created
    call createTaskForAsemTaskSubtype(affectedEObject)
}

reaction AsemTimeTableTaskCreated {
    after element asem_c::TimeTableTask created
    call createTaskForAsemTaskSubtype(affectedEObject)
}

routine createTaskForAsemTaskSubtype(asem_c::Task asemTask) {
    match {
        require absence of am::Task corresponding to asemTask
    }
    create {
        val task = new am::Task
    }
    update {
        task.name = asemTask.name
        persistProjectRelative(asemTask, task, "amalthea/task_" + asemTask.name + ".amxmi")
        addCorrespondenceBetween(asemTask, task)
    }
}

// E23 — InitTask/SoftwareTask/PeriodicTask/TimeTableTask deleted directly on the ASEM
// side -> delete the AMALTHEA Task
reaction AsemInitTaskDeleted {
    after element asem_c::InitTask deleted
    call deleteTaskForAsemTaskSubtype(affectedEObject)
}

reaction AsemSoftwareTaskDeleted {
    after element asem_c::SoftwareTask deleted
    call deleteTaskForAsemTaskSubtype(affectedEObject)
}

reaction AsemPeriodicTaskDeleted {
    after element asem_c::PeriodicTask deleted
    call deleteTaskForAsemTaskSubtype(affectedEObject)
}

reaction AsemTimeTableTaskDeleted {
