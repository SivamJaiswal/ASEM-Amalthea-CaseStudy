// P8, P9 — TypedElement.constant flipped on the ASEM side -> flip Label.constant
reaction MessageConstantFlagChanged {
    after attribute replaced at asem_d::Message[constant]
    call syncConstantFlagToLabel(affectedEObject)
}

reaction InputConstantFlagChanged {
    after attribute replaced at asem_d::Input[constant]
    call syncConstantFlagToLabel(affectedEObject)
}

reaction OutputConstantFlagChanged {
    after attribute replaced at asem_d::Output[constant]
    call syncConstantFlagToLabel(affectedEObject)
}

reaction ConstantConstantFlagChanged {
    after attribute replaced at asem_d::Constant[constant]
    call syncConstantFlagToLabel(affectedEObject)
}

reaction SystemConstantConstantFlagChanged {
    after attribute replaced at asem_d::SystemConstant[constant]
    call syncConstantFlagToLabel(affectedEObject)
}

routine syncConstantFlagToLabel(asem_b::TypedElement typedElement) {
    match {
        val label = retrieve am::Label corresponding to typedElement
    }
    update {
        label.constant = typedElement.constant
    }
}


// SECTION 4 — PrimitiveType -> BaseTypeDefinition (Rules 7-9 / E29-E31)
//             ComposedType -> Array (Rule 10 / E32)


// P12 — Array.numberElements <-> ComposedType.numberElements


// E29 — BooleanType created -> BaseTypeDefinition (size=1 bit)
reaction BooleanTypeCreated {
    after element asem_p::BooleanType created
    call createBaseTypeForBoolean(affectedEObject)
}

routine createBaseTypeForBoolean(asem_p::BooleanType boolType) {
    match {
        require absence of am::BaseTypeDefinition corresponding to boolType
    }
    create {
        val btd = new am::BaseTypeDefinition
        val size = new am::DataSize
    }
    update {
        btd.name = boolType.name
        size.value = 1bi
        size.unit = org.eclipse.app4mc.amalthea.model.DataSizeUnit.BIT
        btd.size = size
        persistProjectRelative(boolType, btd, "amalthea/type_" + boolType.name + ".amxmi")
        addCorrespondenceBetween(boolType, btd)
    }
}

// E30 — UnsignedDiscreteType created -> BaseTypeDefinition
reaction UnsignedDiscreteTypeCreated {
    after element asem_p::UnsignedDiscreteType created
    call createBaseTypeForUnsignedDiscrete(affectedEObject)
}

routine createBaseTypeForUnsignedDiscrete(asem_p::UnsignedDiscreteType udType) {
    match {
        require absence of am::BaseTypeDefinition corresponding to udType
    }
    create {
        val btd = new am::BaseTypeDefinition
        val size = new am::DataSize
        val alias = new am::Alias
    }
    update {
        btd.name = udType.name
        val String userMsg = "An UnsignedDiscreteType '" + udType.name + "' was created in ASEM. " +
            "ASEM doesn't store a bit-width. Which size should the AMALTHEA type get?"
        val String[] selections = #["8", "16", "32"]
        val selected = userInteractor.singleSelectionDialogBuilder.message(userMsg).choices(selections).windowModality(
            tools.vitruv.change.interaction.UserInteractionOptions.WindowModality.MODAL).startInteraction()
        switch (selected) {
            case 0: size.value = 8bi
            case 1: size.value = 16bi
            case 2: size.value = 32bi
            default: size.value = 32bi
        }
        size.unit = org.eclipse.app4mc.amalthea.model.DataSizeUnit.BIT
        btd.size = size
        alias.target = "asem"
        alias.alias = "u" + udType.name
        btd.aliases += alias
        persistProjectRelative(udType, btd, "amalthea/type_" + udType.name + ".amxmi")
        addCorrespondenceBetween(udType, btd)
    }
}

// E30 — SignedDiscreteType created -> BaseTypeDefinition
reaction SignedDiscreteTypeCreated {
    after element asem_p::SignedDiscreteType created
    call createBaseTypeForSignedDiscrete(affectedEObject)
}

routine createBaseTypeForSignedDiscrete(asem_p::SignedDiscreteType sdType) {
    match {
        require absence of am::BaseTypeDefinition corresponding to sdType
    }
    create {
        val btd = new am::BaseTypeDefinition
        val size = new am::DataSize
        val alias = new am::Alias
    }
    update {
        btd.name = sdType.name
        val String userMsg = "A SignedDiscreteType '" + sdType.name + "' was created in ASEM. " +
            "ASEM doesn't store a bit-width. Which size should the AMALTHEA type get?"
        val String[] selections = #["8", "16", "32"]
        val selected = userInteractor.singleSelectionDialogBuilder.message(userMsg).choices(selections).windowModality(
            tools.vitruv.change.interaction.UserInteractionOptions.WindowModality.MODAL).startInteraction()
        switch (selected) {
            case 0: size.value = 8bi
            case 1: size.value = 16bi
            case 2: size.value = 32bi
            default: size.value = 32bi
        }
        size.unit = org.eclipse.app4mc.amalthea.model.DataSizeUnit.BIT
        btd.size = size
        alias.target = "asem"
        alias.alias = sdType.name
        btd.aliases += alias
        persistProjectRelative(sdType, btd, "amalthea/type_" + sdType.name + ".amxmi")
        addCorrespondenceBetween(sdType, btd)
    }
}

// E31 — ContinuousType created -> BaseTypeDefinition
reaction ContinuousTypeCreated {
    after element asem_p::ContinuousType created
    call createBaseTypeForContinuous(affectedEObject)
}

routine createBaseTypeForContinuous(asem_p::ContinuousType contType) {
    match {
        require absence of am::BaseTypeDefinition corresponding to contType
    }
    create {
        val btd = new am::BaseTypeDefinition
        val size = new am::DataSize
        val alias = new am::Alias
    }
    update {
        btd.name = contType.name
        val String userMsg = "A ContinuousType '" + contType.name + "' was created in ASEM. " +
            "ASEM doesn't store a bit-width. Which size should the AMALTHEA type get?"
        val String[] selections = #["32", "64"]
        val selected = userInteractor.singleSelectionDialogBuilder.message(userMsg).choices(selections).windowModality(
            tools.vitruv.change.interaction.UserInteractionOptions.WindowModality.MODAL).startInteraction()
        switch (selected) {
            case 0: size.value = 32bi
            case 1: size.value = 64bi
            default: size.value = 64bi
        }
        size.unit = org.eclipse.app4mc.amalthea.model.DataSizeUnit.BIT
        btd.size = size
        alias.target = "asem"
        alias.alias = "double" + contType.name
        btd.aliases += alias
        persistProjectRelative(contType, btd, "amalthea/type_" + contType.name + ".amxmi")
        addCorrespondenceBetween(contType, btd)
    }
}

// E32 — ComposedType created -> Array
reaction ComposedTypeCreated {
    after element asem_c::ComposedType created
    call createArrayForComposedType(affectedEObject)
}

routine createArrayForComposedType(asem_c::ComposedType composedType) {
    match {
        require absence of am::Array corresponding to composedType
    }
    create {
        val array = new am::Array
    }
    update {
        array.numberElements = composedType.numberElements
        persistProjectRelative(composedType, array, "amalthea/array_" + composedType.name + ".amxmi")
        addCorrespondenceBetween(composedType, array)
    }
}

// P12 — ComposedType.numberElements changed → keep the corresponding Array in sync
reaction ComposedTypeNumberElementsChanged {
    after attribute replaced at asem_c::ComposedType[numberElements]
    call syncComposedTypeNumberElementsToArray(affectedEObject)
}

routine syncComposedTypeNumberElementsToArray(asem_c::ComposedType composedType) {
    match {
        val array = retrieve am::Array corresponding to composedType
    }
    update {
        array.numberElements = composedType.numberElements
    }
}


// SECTION 5 — Task/InterruptTask ↔ Task/ISR   (Rules 2 & 3 / E22-E25)


// E22 — ASEM Task created -> create an AMALTHEA Task
reaction AsemTaskCreated {
    after element asem_c::Task created
    call createTaskForAsemTask(affectedEObject)
}

routine createTaskForAsemTask(asem_c::Task asemTask) {
