// P15 — InitTask/SoftwareTask/PeriodicTask/TimeTableTask renamed directly on the ASEM
// side -> update AMALTHEA Task.name
reaction AsemInitTaskRenamed {
    after attribute replaced at asem_c::InitTask[name]
    call syncAsemTaskSubtypeNameToTask(affectedEObject)
}

reaction AsemSoftwareTaskRenamed {
    after attribute replaced at asem_c::SoftwareTask[name]
    call syncAsemTaskSubtypeNameToTask(affectedEObject)
}

reaction AsemPeriodicTaskRenamed {
    after attribute replaced at asem_c::PeriodicTask[name]
    call syncAsemTaskSubtypeNameToTask(affectedEObject)
}

